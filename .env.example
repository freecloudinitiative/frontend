# Base URL for the backend API (Build-time).
# When not set the axios instance defaults to http://localhost:3000 (local mock dev).
VITE_API_BASE_URL=http://localhost:3000

# Nginx reverse proxy backend target (Container Runtime).
API_BACKEND_URL=http://localhost:8080

# OIDC (Authentik) configuration — leave unset to run the app in
# unauthenticated pass-through mode (no login required, local dev default).
# Both VITE_OIDC_AUTHORITY and VITE_OIDC_CLIENT_ID must be set to enable auth.
VITE_OIDC_AUTHORITY=https://auth.example.com/application/o/fci/
VITE_OIDC_CLIENT_ID=your-client-id
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback

# WebSocket Terminal (Build-time)
# Set VITE_ENABLE_REAL_TERMINAL=true to use a real backend WebSocket terminal.
# Leave unset (or "false") to run the mock shell (default local dev behaviour).
VITE_ENABLE_REAL_TERMINAL=false
VITE_WS_BASE_URL=ws://localhost:8080
